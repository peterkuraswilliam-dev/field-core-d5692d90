# Public Supabase values used by the browser bundle.
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-side equivalents used during SSR and server functions.
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Add only if trusted server-side admin operations use client.server.ts.
# Never prefix this value with VITE_.
SUPABASE_SERVICE_ROLE_KEY=
